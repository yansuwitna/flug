generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusPengguna {
  AKTIF
  NONAKTIF
  DITANGGUHKAN

  @@map("status_pengguna")
}

enum TipeKonten {
  VIDEO_SEMATAN
  VIDEO_BERKAS
  TEKS
  TAUTAN
  DOKUMEN

  @@map("tipe_konten")
}

enum TipeTantangan {
  TEKS
  NUMERIK
  PILIHAN_GANDA
  URUTAN
  STUDI_KASUS

  @@map("tipe_tantangan")
}

enum StatusMisi {
  DRAF
  DITERBITKAN
  DIARSIPKAN

  @@map("status_misi")
}

enum StatusPercobaan {
  SEDANG_BERJALAN
  SELESAI
  DITINGGALKAN

  @@map("status_percobaan")
}

enum SumberXp {
  SELESAI_MISI
  SELESAI_TANTANGAN
  PENALTI_PETUNJUK
  BONUS

  @@map("sumber_xp")
}

model Admin {
  id           String         @id @default(cuid()) @map("id")
  nama         String         @map("nama")
  email        String         @unique @map("email")
  kataSandi    String         @map("kata_sandi")
  status       StatusPengguna @default(AKTIF) @map("status")
  urlFoto      String?        @map("url_foto")
  dibuatPada   DateTime       @default(now()) @map("dibuat_pada")
  diperbaruiPada DateTime     @updatedAt @map("diperbarui_pada")

  logAudit     LogAudit[]

  @@index([email])
  @@map("admin")
}

model Guru {
  id           String         @id @default(cuid()) @map("id")
  nip          String?        @unique @map("nip")
  nama         String         @map("nama")
  email        String         @unique @map("email")
  kataSandi    String         @map("kata_sandi")
  status       StatusPengguna @default(AKTIF) @map("status")
  urlFoto      String?        @map("url_foto")
  dibuatPada   DateTime       @default(now()) @map("dibuat_pada")
  diperbaruiPada DateTime     @updatedAt @map("diperbarui_pada")

  mapelKelas   MapelKelas[]
  misiDibuat   Misi[]

  @@index([email])
  @@map("guru")
}

model Siswa {
  id             String          @id @default(cuid()) @map("id")
  nisn           String?         @unique @map("nisn")
  nama           String          @map("nama")
  email          String          @unique @map("email")
  kataSandi      String          @map("kata_sandi")
  status         StatusPengguna  @default(AKTIF) @map("status")
  urlFoto        String?         @map("url_foto")
  dibuatPada     DateTime        @default(now()) @map("dibuat_pada")
  diperbaruiPada DateTime        @updatedAt @map("diperbarui_pada")

  anggotaKelas   AnggotaKelas[]
  percobaanMisi  PercobaanMisi[]
  transaksiXp    TransaksiXp[]
  lencanaSiswa   LencanaSiswa[]

  @@index([email])
  @@map("siswa")
}

model TahunAjaran {
  id          String   @id @default(cuid()) @map("id")
  nama        String   @unique @map("nama") // Contoh: "2025/2026 Ganjil"
  tanggalMulai DateTime @map("tanggal_mulai")
  tanggalSelesai DateTime @map("tanggal_selesai")
  aktif       Boolean  @default(false) @map("aktif")
  dibuatPada  DateTime @default(now()) @map("dibuat_pada")
  diperbaruiPada DateTime @updatedAt @map("diperbarui_pada")

  kelas       Kelas[]

  @@map("tahun_ajaran")
}

model Kelas {
  id            String       @id @default(cuid()) @map("id")
  nama          String       @map("nama") // Contoh: "X RPL 1"
  tingkat       Int          @map("tingkat") // Tingkat kelas: 10, 11, 12
  jurusan       String?      @map("jurusan") // Program/Jurusan: "Rekayasa Perangkat Lunak"
  idTahunAjaran String       @map("id_tahun_ajaran")
  dibuatPada    DateTime     @default(now()) @map("dibuat_pada")
  diperbaruiPada DateTime    @updatedAt @map("diperbarui_pada")

  tahunAjaran   TahunAjaran  @relation(fields: [idTahunAjaran], references: [id], onDelete: Cascade)
  anggota       AnggotaKelas[]
  mapelKelas    MapelKelas[]

  @@unique([nama, idTahunAjaran])
  @@index([idTahunAjaran])
  @@map("kelas")
}

model AnggotaKelas {
  id          String   @id @default(cuid()) @map("id")
  idKelas     String   @map("id_kelas")
  idSiswa     String   @map("id_siswa")
  bergabungPada DateTime @default(now()) @map("bergabung_pada")

  kelas       Kelas    @relation(fields: [idKelas], references: [id], onDelete: Cascade)
  siswa       Siswa    @relation(fields: [idSiswa], references: [id], onDelete: Cascade)

  @@unique([idKelas, idSiswa])
  @@index([idSiswa])
  @@index([idKelas])
  @@map("anggota_kelas")
}

model MataPelajaran {
  id          String       @id @default(cuid()) @map("id")
  kode        String       @unique @map("kode") // Contoh: "INF-X"
  nama        String       @map("nama") // Contoh: "Informatika & Jaringan Dasar"
  deskripsi   String?      @db.Text @map("deskripsi")
  dibuatPada  DateTime     @default(now()) @map("dibuat_pada")
  diperbaruiPada DateTime  @updatedAt @map("diperbarui_pada")

  bab         Bab[]
  mapelKelas  MapelKelas[]

  @@map("mata_pelajaran")
}

model MapelKelas {
  id              String        @id @default(cuid()) @map("id")
  idKelas         String        @map("id_kelas")
  idMataPelajaran String        @map("id_mata_pelajaran")
  idGuru          String        @map("id_guru")
  dibuatPada      DateTime      @default(now()) @map("dibuat_pada")
  diperbaruiPada  DateTime      @updatedAt @map("diperbarui_pada")

  kelas           Kelas         @relation(fields: [idKelas], references: [id], onDelete: Cascade)
  mataPelajaran   MataPelajaran @relation(fields: [idMataPelajaran], references: [id], onDelete: Cascade)
  guru            Guru          @relation(fields: [idGuru], references: [id], onDelete: Cascade)
  misi            Misi[]

  @@unique([idKelas, idMataPelajaran, idGuru])
  @@index([idKelas])
  @@index([idMataPelajaran])
  @@index([idGuru])
  @@map("mapel_kelas")
}

model Bab {
  id              String        @id @default(cuid()) @map("id")
  idMataPelajaran String        @map("id_mata_pelajaran")
  judul           String        @map("judul")
  deskripsi       String?       @db.Text @map("deskripsi")
  nomorUrut       Int           @default(1) @map("nomor_urut")
  dibuatPada      DateTime      @default(now()) @map("dibuat_pada")
  diperbaruiPada  DateTime      @updatedAt @map("diperbarui_pada")

  mataPelajaran   MataPelajaran @relation(fields: [idMataPelajaran], references: [id], onDelete: Cascade)
  misi            Misi[]

  @@index([idMataPelajaran])
  @@map("bab")
}

model Misi {
  id              String            @id @default(cuid()) @map("id")
  idMapelKelas    String            @map("id_mapel_kelas")
  idBab           String            @map("id_bab")
  idPembuat       String            @map("id_pembuat")
  judul           String            @map("judul")
  slug            String            @unique @map("slug")
  deskripsi       String            @db.Text @map("deskripsi")
  tujuanBelajar   String?           @db.Text @map("tujuan_belajar")
  tingkatKesulitan String           @default("SEDANG") @map("tingkat_kesulitan") // MUDAH, SEDANG, SULIT
  status          StatusMisi        @default(DRAF) @map("status")
  durasiMenit     Int?              @map("durasi_menit")
  maksPercobaan   Int               @default(3) @map("maks_percobaan")
  totalPoin       Int               @default(0) @map("total_poin")
  nomorUrut       Int               @default(1) @map("nomor_urut")
  diterbitkanPada DateTime?         @map("diterbitkan_pada")
  dibuatPada      DateTime          @default(now()) @map("dibuat_pada")
  diperbaruiPada  DateTime          @updatedAt @map("diperbarui_pada")

  mapelKelas      MapelKelas        @relation(fields: [idMapelKelas], references: [id], onDelete: Cascade)
  bab             Bab               @relation(fields: [idBab], references: [id], onDelete: Cascade)
  pembuat         Guru              @relation(fields: [idPembuat], references: [id], onDelete: Cascade)
  kontenBelajar   KontenBelajar[]
  tantangan       Tantangan[]
  percobaan       PercobaanMisi[]

  @@index([idMapelKelas])
  @@index([idBab])
  @@index([idPembuat])
  @@index([status])
  @@map("misi")
}

model KontenBelajar {
  id          String     @id @default(cuid()) @map("id")
  idMisi      String     @map("id_misi")
  tipeKonten  TipeKonten @default(TEKS) @map("tipe_konten")
  judul       String     @map("judul")
  isi         String?    @db.LongText @map("isi")
  urlMedia    String?    @map("url_media")
  nomorUrut   Int        @default(1) @map("nomor_urut")
  durasiDetik Int?       @map("durasi_detik")
  dibuatPada  DateTime   @default(now()) @map("dibuat_pada")
  diperbaruiPada DateTime @updatedAt @map("diperbarui_pada")

  misi        Misi       @relation(fields: [idMisi], references: [id], onDelete: Cascade)

  @@index([idMisi])
  @@map("konten_belajar")
}

model Tantangan {
  id            String        @id @default(cuid()) @map("id")
  idMisi        String        @map("id_misi")
  judul         String        @map("judul")
  pertanyaan    String        @db.Text @map("pertanyaan")
  deskripsi     String?       @db.Text @map("deskripsi")
  tipeTantangan TipeTantangan @default(TEKS) @map("tipe_tantangan")
  poin          Int           @default(100) @map("poin")
  nomorUrut     Int           @default(1) @map("nomor_urut")
  maksMencoba   Int           @default(5) @map("maks_mencoba")
  dibuatPada    DateTime      @default(now()) @map("dibuat_pada")
  diperbaruiPada DateTime     @updatedAt @map("diperbarui_pada")

  misi          Misi          @relation(fields: [idMisi], references: [id], onDelete: Cascade)
  opsi          OpsiTantangan[]
  kunciJawaban  KunciJawaban[]
  petunjuk      Petunjuk[]
  kirimanJawaban KirimanJawaban[]

  @@index([idMisi])
  @@map("tantangan")
}

model OpsiTantangan {
  id          String    @id @default(cuid()) @map("id")
  idTantangan String    @map("id_tantangan")
  teksOpsi    String    @map("teks_opsi")
  nomorUrut   Int       @default(1) @map("nomor_urut")
  dibuatPada  DateTime  @default(now()) @map("dibuat_pada")

  tantangan   Tantangan @relation(fields: [idTantangan], references: [id], onDelete: Cascade)

  @@index([idTantangan])
  @@map("opsi_tantangan")
}

model KunciJawaban {
  id                String    @id @default(cuid()) @map("id")
  idTantangan       String    @map("id_tantangan")
  hashJawaban       String    @map("hash_jawaban") // HMAC-SHA256 hash
  hurufBesarKecil   Boolean   @default(false) @map("huruf_besar_kecil")
  pangkasSpasi      Boolean   @default(true) @map("pangkas_spasi")
  dibuatPada        DateTime  @default(now()) @map("dibuat_pada")

  tantangan         Tantangan @relation(fields: [idTantangan], references: [id], onDelete: Cascade)

  @@index([idTantangan])
  @@map("kunci_jawaban")
}

model Petunjuk {
  id             String          @id @default(cuid()) @map("id")
  idTantangan    String          @map("id_tantangan")
  judul          String          @map("judul")
  teksPetunjuk   String          @db.Text @map("teks_petunjuk")
  penaltiXp      Int             @default(0) @map("penalti_xp")
  nomorUrut      Int             @default(1) @map("nomor_urut")
  dibuatPada     DateTime        @default(now()) @map("dibuat_pada")

  tantangan      Tantangan       @relation(fields: [idTantangan], references: [id], onDelete: Cascade)
  penggunaanPetunjuk PenggunaanPetunjuk[]

  @@index([idTantangan])
  @@map("petunjuk")
}

model PercobaanMisi {
  id             String          @id @default(cuid()) @map("id")
  idSiswa        String          @map("id_siswa")
  idMisi         String          @map("id_misi")
  nomorPercobaan Int             @default(1) @map("nomor_percobaan")
  status         StatusPercobaan @default(SEDANG_BERJALAN) @map("status")
  dimulaiPada    DateTime        @default(now()) @map("dimulai_pada")
  selesaiPada    DateTime?       @map("selesai_pada")

  siswa          Siswa           @relation(fields: [idSiswa], references: [id], onDelete: Cascade)
  misi           Misi            @relation(fields: [idMisi], references: [id], onDelete: Cascade)
  kirimanJawaban KirimanJawaban[]
  penggunaanPetunjuk PenggunaanPetunjuk[]
  hasil          HasilMisi?

  @@unique([idSiswa, idMisi, nomorPercobaan])
  @@index([idSiswa])
  @@index([idMisi])
  @@map("percobaan_misi")
}

model KirimanJawaban {
  id             String        @id @default(cuid()) @map("id")
  idPercobaan    String        @map("id_percobaan")
  idTantangan    String        @map("id_tantangan")
  jawabanTerkirim String       @map("jawaban_terkirim")
  benar          Boolean       @default(false) @map("benar")
  poinDidapat    Int           @default(0) @map("poin_didapat")
  dikirimPada    DateTime      @default(now()) @map("dikirim_pada")

  percobaan      PercobaanMisi @relation(fields: [idPercobaan], references: [id], onDelete: Cascade)
  tantangan      Tantangan     @relation(fields: [idTantangan], references: [id], onDelete: Cascade)

  @@index([idPercobaan])
  @@index([idTantangan])
  @@map("kiriman_jawaban")
}

model PenggunaanPetunjuk {
  id             String        @id @default(cuid()) @map("id")
  idPercobaan    String        @map("id_percobaan")
  idPetunjuk     String        @map("id_petunjuk")
  penaltiDipotong Int          @default(0) @map("penalti_dipotong")
  dibukaPada     DateTime      @default(now()) @map("dibuka_pada")

  percobaan      PercobaanMisi @relation(fields: [idPercobaan], references: [id], onDelete: Cascade)
  petunjuk       Petunjuk      @relation(fields: [idPetunjuk], references: [id], onDelete: Cascade)

  @@unique([idPercobaan, idPetunjuk])
  @@index([idPercobaan])
  @@index([idPetunjuk])
  @@map("penggunaan_petunjuk")
}

model HasilMisi {
  id             String        @id @default(cuid()) @map("id")
  idPercobaan    String        @unique @map("id_percobaan")
  totalSkor      Int           @default(0) @map("total_skor")
  xpDidapat      Int           @default(0) @map("xp_didapat")
  selesaiPada    DateTime      @default(now()) @map("selesai_pada")

  percobaan      PercobaanMisi @relation(fields: [idPercobaan], references: [id], onDelete: Cascade)

  @@map("hasil_misi")
}

model TransaksiXp {
  id           String    @id @default(cuid()) @map("id")
  idSiswa      String    @map("id_siswa")
  jumlah       Int       @map("jumlah") // Positif (penambahan) atau negatif (penalti)
  sumber       SumberXp  @map("sumber")
  idReferensi  String?   @map("id_referensi")
  deskripsi    String    @map("deskripsi")
  dibuatPada   DateTime  @default(now()) @map("dibuat_pada")

  siswa        Siswa     @relation(fields: [idSiswa], references: [id], onDelete: Cascade)

  @@index([idSiswa])
  @@index([sumber])
  @@map("transaksi_xp")
}

model Lencana {
  id          String         @id @default(cuid()) @map("id")
  nama        String         @unique @map("nama")
  slug        String         @unique @map("slug")
  deskripsi   String         @map("deskripsi")
  urlIkon     String?        @map("url_ikon")
  kriteria    String         @map("kriteria") // JSON kriteria unlock
  dibuatPada  DateTime       @default(now()) @map("dibuat_pada")

  lencanaSiswa LencanaSiswa[]

  @@map("lencana")
}

model LencanaSiswa {
  id           String    @id @default(cuid()) @map("id")
  idSiswa      String    @map("id_siswa")
  idLencana    String    @map("id_lencana")
  diberikanPada DateTime @default(now()) @map("diberikan_pada")

  siswa        Siswa     @relation(fields: [idSiswa], references: [id], onDelete: Cascade)
  lencana      Lencana   @relation(fields: [idLencana], references: [id], onDelete: Cascade)

  @@unique([idSiswa, idLencana])
  @@index([idSiswa])
  @@index([idLencana])
  @@map("lencana_siswa")
}

model LogAudit {
  id          String   @id @default(cuid()) @map("id")
  idAdmin     String?  @map("id_admin")
  aksi        String   @map("aksi")
  target      String   @map("target")
  metadata    String?  @db.Text @map("metadata")
  dibuatPada  DateTime @default(now()) @map("dibuat_pada")

  admin       Admin?   @relation(fields: [idAdmin], references: [id], onDelete: SetNull)

  @@index([idAdmin])
  @@index([aksi])
  @@map("log_audit")
}
